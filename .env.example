# Copy to .env.local (gitignored) and fill in values.
# Never commit real passwords or production connection strings.

# =============================================================================
# REQUIRED for Verify product (search + detail pages)
# =============================================================================
#
# Supabase → Project Settings → Database → Connection string → URI
#
# For Vercel + local app runtime: use Session pooler (port 5432).
#   - Host looks like: aws-0-<region>.pooler.supabase.com
#   - User looks like: postgres.<project-ref>
#   - Direct db.<ref>.supabase.co is often IPv6-only and fails on many networks
#   - Transaction pooler (:6543) is not recommended for this Next.js app
#
# Example Session pooler:
# DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-ca-central-1.pooler.supabase.com:5432/postgres
#
# Example Direct (ingest machines with IPv6, not Vercel):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

DATABASE_URL=

# AskTrustHub signed claim handoff (server-only; configure in Vercel, never NEXT_PUBLIC_)
ATH_HANDOFF_SECRET=
# off | canary | all (start with canary and ATH_CLAIM_CANARY_PROFILE_IDS)
ATH_CLAIM_CTA_MODE=off
ATH_CLAIM_CANARY_PROFILE_IDS=

# =============================================================================
# REQUIRED for production SEO (canonicals, robots, sitemap, Open Graph)
# =============================================================================
# Always use the custom www domain — never a *.vercel.app preview host.
NEXT_PUBLIC_SITE_URL=https://www.contractortrusthub.com

# Corrections form mailto destination (defaults to corrections@contractortrusthub.com)
# NEXT_PUBLIC_CORRECTIONS_EMAIL=corrections@yourdomain.com

# Optional Postgres tuning
# PGCONNECT_TIMEOUT=30
# PGSSLMODE=require
