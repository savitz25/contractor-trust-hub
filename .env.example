# Copy to .env.local (gitignored) and fill in values.
# Never commit real passwords.

# Supabase → Project Settings → Database → Connection string → URI
# Prefer: Direct connection (db.<project-ref>.supabase.co:5432)
#    or: Session pooler (port 5432) for bulk loads
# Avoid Transaction pooler (:6543) for schema + long ingest runs.
#
# Example (replace password + project ref):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

DATABASE_URL=

# Public site URL (SEO / Open Graph absolute URLs)
# NEXT_PUBLIC_SITE_URL=https://contractortrusthub.com

# Optional overrides
# PGCONNECT_TIMEOUT=30
