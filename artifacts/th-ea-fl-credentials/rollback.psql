-- TH-EA-UNPUBLISHED-2026-10-01-FL-CREDENTIALS bounded data rollback.
-- Deletes only credentials inserted under these three fixed ingest batches.
-- No contractors, board 06, other credentials, or person profiles are changed.
BEGIN ISOLATION LEVEL SERIALIZABLE;
SET LOCAL lock_timeout = '10s';
SET LOCAL statement_timeout = '5min';
DO $$
DECLARE changed integer;
BEGIN
  IF EXISTS (
    SELECT 1 FROM licenses l
    WHERE l.ingest_batch_id IN
      ('e3e1c7c3-e337-5bc4-8143-4631415db763',
       '1a89ece4-7f97-576c-a639-ca15316054c5',
       '20a365ff-a740-515d-bd96-574809e62a4d')
      AND (l.source_system<>'fl_dbpr' OR l.contractor_id IS NOT NULL
        OR l.board_number NOT IN ('08','07','04')
        OR l.source_board IS DISTINCT FROM l.board_number
        OR l.raw_payload->>'credential_grain' IS DISTINCT FROM 'person'
        OR l.ingest_batch_id IS DISTINCT FROM
          CASE l.board_number WHEN '08' THEN 'e3e1c7c3-e337-5bc4-8143-4631415db763'::uuid
            WHEN '07' THEN '1a89ece4-7f97-576c-a639-ca15316054c5'::uuid
            WHEN '04' THEN '20a365ff-a740-515d-bd96-574809e62a4d'::uuid END
        OR l.raw_payload->>'source_dataset' IS DISTINCT FROM
          CASE l.board_number WHEN '08' THEN 'fl_dbpr_eclb_08'
            WHEN '07' THEN 'fl_dbpr_mold_07' WHEN '04' THEN 'fl_dbpr_home_04' END
        OR l.raw_payload->>'source_sha256' IS DISTINCT FROM
          CASE l.board_number WHEN '08' THEN 'b1bbbd8f6c707869376357ec914ce98a3fb1269669e4b79ebe61442b74540754'
            WHEN '07' THEN '705bcf08e2b82f71c79fa0afffc906c5f853362dd9232d6506efdb546b3cd08e'
            WHEN '04' THEN 'd403712866922381a124ec6def6c0f61e57a7cc3f51b46708029eecfd9b93cf1' END
        OR NOT ((l.board_number='08' AND l.occupation_code IN ('EC','EF','EG','ES','ER','EY','EZ','ET','EH','EI','EJ'))
          OR (l.board_number='07' AND l.occupation_code IN ('MRSA','MRSR'))
          OR (l.board_number='04' AND l.occupation_code='HI')))
  ) THEN RAISE EXCEPTION 'Florida credential rollback batch contains unexpected row'; END IF;
  DELETE FROM licenses
  WHERE ingest_batch_id IN
    ('e3e1c7c3-e337-5bc4-8143-4631415db763',
     '1a89ece4-7f97-576c-a639-ca15316054c5',
     '20a365ff-a740-515d-bd96-574809e62a4d');
  GET DIAGNOSTICS changed=ROW_COUNT;
  DELETE FROM ingest_batches
  WHERE id IN
    ('e3e1c7c3-e337-5bc4-8143-4631415db763',
     '1a89ece4-7f97-576c-a639-ca15316054c5',
     '20a365ff-a740-515d-bd96-574809e62a4d')
    AND source_system='fl_dbpr'
    AND notes LIKE 'TH-EA-UNPUBLISHED-2026-10-01-FL-CREDENTIALS%';
  IF EXISTS (SELECT 1 FROM licenses WHERE ingest_batch_id IN
    ('e3e1c7c3-e337-5bc4-8143-4631415db763',
     '1a89ece4-7f97-576c-a639-ca15316054c5',
     '20a365ff-a740-515d-bd96-574809e62a4d'))
  THEN RAISE EXCEPTION 'Florida credential rollback incomplete'; END IF;
  RAISE NOTICE 'FL CERTIFIED CREDENTIAL REMOVED=%',changed;
END $$;
COMMIT;
