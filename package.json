{
  "name": "contractor-trust-hub",
  "version": "0.1.0",
  "description": "ContractorTrustHub — Before you hire, verify. Evidence-backed contractor license research.",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test": "node scripts/assert-brand-001.mjs && node scripts/assert-share-002.mjs && node scripts/assert-share-003.mjs && node scripts/assert-visual-007.mjs && npm run assert:contractor-discovery-pilot && npm run assert:ask-handoff",
    "assert:contractor-discovery-pilot": "npx --yes tsx scripts/assert-contractor-discovery-pilot.mts",
    "assert:ask-handoff": "npx --yes tsx scripts/assert-ask-handoff-consumer.mts",
    "publish:contractor-discovery-pilot": "npx --yes tsx scripts/publish-contractor-discovery-pilot.mts",
    "assert:visual": "node scripts/assert-visual-007.mjs",
    "assert:brand": "node scripts/assert-brand-001.mjs",
    "typecheck": "tsc --noEmit",
    "test:matcher": "node scripts/test_permit_matcher.mjs",
    "test:nj": "node scripts/test_nj_verify_smoke.mjs",
    "test:funnel": "node scripts/test_funnel_smoke.mjs",
    "verify:stage6": "node scripts/verify_stage6_migration.mjs",
    "verify:stage7": "node scripts/verify_stage7_data.mjs",
    "verify:ops": "node scripts/verify_production_data.mjs",
    "load:wave-a": "node scripts/load_wave_permits.mjs --wave A",
    "load:wave-bc": "node scripts/load_wave_permits.mjs --wave B,C",
    "load:permits": "node scripts/load_wave_permits.mjs",
    "rebuild:activity": "node scripts/rebuild_permit_activity.mjs",
    "audit:joins": "node scripts/audit_permit_joins.mjs",
    "audit:production": "node scripts/audit_production_joins.mjs",
    "ops:snapshot": "node scripts/ops_snapshot.mjs",
    "test:ops": "node scripts/test_ops_smoke.mjs",
    "test:fl-safety": "python -m unittest scripts.test_fl_dbpr_identity && node --experimental-strip-types scripts/test_fl_regulatory_publication.ts",
    "check:journey-v21": "node scripts/check-journey-v21.mjs"
  },
  "dependencies": {
    "next": "^15.5.23",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
