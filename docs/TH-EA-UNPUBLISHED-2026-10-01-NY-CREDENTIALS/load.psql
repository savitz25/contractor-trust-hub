-- REVIEW PACKET ONLY. Current sources are Evidence-certified; Founder execution GO is still required.
-- Run with psql -X -v ON_ERROR_STOP=1 from the repository root.
-- First verify the CSV SHA-256 in receipt.json and both official source hashes.
BEGIN;

CREATE TEMP TABLE ny_credential_stage (
  source_dataset text, source_line text, source_system text, external_key text,
  license_type text, license_number text, holder_name text, dba_name text,
  address text, address_2 text, city text, address_state text, zip_code text,
  issued_date text, expiration_date text, source_status text, source_sha256 text,
  source_url text, batch_id text, raw_payload text
) ON COMMIT DROP;

\copy ny_credential_stage FROM 'docs/TH-EA-UNPUBLISHED-2026-10-01-NY-CREDENTIALS/ny-credentials-stage.csv' WITH (FORMAT csv, HEADER true)

DO $$
BEGIN
  IF (SELECT count(*) FROM ny_credential_stage) <> 2813
     OR (SELECT count(*) FROM ny_credential_stage WHERE source_dataset='ny_dol_mold') <> 2511
     OR (SELECT count(*) FROM ny_credential_stage WHERE source_dataset='ny_elevator') <> 302
     OR (SELECT count(*) FROM ny_credential_stage WHERE source_dataset='ny_dol_mold' AND source_status='Expired') <> 774
     OR (SELECT count(*) FROM ny_credential_stage WHERE source_dataset='ny_elevator' AND source_status='Expired') <> 90
     OR (SELECT count(DISTINCT license_number) FROM ny_credential_stage WHERE source_dataset='ny_dol_mold') <> 2483
     OR (SELECT count(DISTINCT (source_system,external_key)) FROM ny_credential_stage) <> 2813
     OR EXISTS (SELECT 1 FROM ny_credential_stage WHERE source_system <> 'ny_dol'
       OR source_status NOT IN ('Active','Expired') OR external_key IS NULL OR license_number IS NULL
       OR holder_name IS NULL OR holder_name='' OR source_dataset NOT IN ('ny_dol_mold','ny_elevator'))
     OR EXISTS (SELECT 1 FROM ny_credential_stage WHERE
       (source_dataset='ny_dol_mold' AND (source_sha256 <> '5eda889f071350c8e1c1bed040f177de1b0a28e64619afabadb9a4fae468927c'
         OR batch_id <> '637955be-0fc3-5beb-aa6f-52904f3184f0'))
       OR (source_dataset='ny_elevator' AND (source_sha256 <> '4e7dd536aacb197589ffc0df56c35ffc2b6289912cb24bf6289bd141b2f741da'
         OR batch_id <> 'cf41ef92-452b-553d-927e-f3944c3d2dfd')))
     OR EXISTS (SELECT 1 FROM ny_credential_stage WHERE external_key <> source_dataset || ':' || license_type || ':' || license_number)
  THEN RAISE EXCEPTION 'Certified NY credential stage invariant failed'; END IF;

  -- Existing exact keys are acceptable only as identical reruns of this same batch.
  IF EXISTS (
    SELECT 1 FROM ny_credential_stage s JOIN public.licenses l
      ON l.source_system=s.source_system AND l.external_key=s.external_key
    WHERE l.contractor_id IS NOT NULL OR l.ingest_batch_id::text IS DISTINCT FROM s.batch_id
       OR l.license_number IS DISTINCT FROM s.license_number
       OR l.occupation_description IS DISTINCT FROM s.license_type
       OR l.primary_status IS DISTINCT FROM s.source_status
       OR l.raw_payload IS DISTINCT FROM s.raw_payload::jsonb
  ) THEN RAISE EXCEPTION 'Existing exact credential differs; stop for ownership review'; END IF;

  IF EXISTS (
    SELECT 1 FROM public.ingest_batches b
    WHERE b.id IN ('637955be-0fc3-5beb-aa6f-52904f3184f0','cf41ef92-452b-553d-927e-f3944c3d2dfd')
      AND (b.source_system <> 'ny_dol'
        OR (b.id='637955be-0fc3-5beb-aa6f-52904f3184f0' AND
          (b.source_dataset <> 'ny_dol_mold' OR b.row_count <> 2511 OR b.checksum_sha256 <> '5eda889f071350c8e1c1bed040f177de1b0a28e64619afabadb9a4fae468927c'))
        OR (b.id='cf41ef92-452b-553d-927e-f3944c3d2dfd' AND
          (b.source_dataset <> 'ny_elevator' OR b.row_count <> 302 OR b.checksum_sha256 <> '4e7dd536aacb197589ffc0df56c35ffc2b6289912cb24bf6289bd141b2f741da')))
  ) THEN RAISE EXCEPTION 'Existing ingest batch metadata differs'; END IF;
END $$;

INSERT INTO public.ingest_batches
  (id,source_system,source_dataset,source_url,source_file,row_count,checksum_sha256,notes)
VALUES
  ('637955be-0fc3-5beb-aa6f-52904f3184f0','ny_dol','ny_dol_mold','https://data.ny.gov/resource/ikqx-ispy.csv','ikqx-ispy.csv',2511,'5eda889f071350c8e1c1bed040f177de1b0a28e64619afabadb9a4fae468927c','Evidence-certified 2026-10-01 credential snapshot; no canonical business links'),
  ('cf41ef92-452b-553d-927e-f3944c3d2dfd','ny_dol','ny_elevator','https://data.ny.gov/resource/jrac-r9vc.csv','jrac-r9vc.csv',302,'4e7dd536aacb197589ffc0df56c35ffc2b6289912cb24bf6289bd141b2f741da','Evidence-certified 2026-10-01 credential snapshot; no canonical business links')
ON CONFLICT (id) DO NOTHING;

INSERT INTO public.licenses (
  contractor_id,source_system,external_key,occupation_code,occupation_description,
  license_number,class_code,licensee_name_raw,dba_name_raw,primary_status,status_normalized,
  original_licensure_date,expiration_date,address_line_1,address_line_2,city,state,postal_code,
  raw_payload,ingest_batch_id
)
SELECT NULL,s.source_system,s.external_key,
  CASE s.source_dataset WHEN 'ny_dol_mold' THEN 'NY_DOL_MOLD' ELSE 'NY_DOL_ELEVATOR' END,
  s.license_type,s.license_number,substring(s.license_type FROM 'SH[0-9]+'),
  s.holder_name,NULLIF(s.dba_name,''),s.source_status,lower(s.source_status),
  NULLIF(s.issued_date,'')::date,NULLIF(s.expiration_date,'')::date,
  NULLIF(s.address,''),NULLIF(s.address_2,''),NULLIF(s.city,''),NULLIF(s.address_state,''),NULLIF(s.zip_code,''),
  s.raw_payload::jsonb,s.batch_id::uuid
FROM ny_credential_stage s
ON CONFLICT (source_system,external_key) DO NOTHING;

DO $$
BEGIN
  IF (SELECT count(*) FROM public.licenses WHERE ingest_batch_id='637955be-0fc3-5beb-aa6f-52904f3184f0') <> 2511
     OR (SELECT count(*) FROM public.licenses WHERE ingest_batch_id='cf41ef92-452b-553d-927e-f3944c3d2dfd') <> 302
     OR EXISTS (SELECT 1 FROM public.licenses WHERE ingest_batch_id IN
       ('637955be-0fc3-5beb-aa6f-52904f3184f0','cf41ef92-452b-553d-927e-f3944c3d2dfd')
       AND contractor_id IS NOT NULL)
  THEN RAISE EXCEPTION 'NY credential post-insert invariant failed; transaction rolled back'; END IF;
END $$;

SELECT source_dataset, count(*) AS staged,
  count(*) FILTER (WHERE l.ingest_batch_id IS NOT NULL) AS exact_present
FROM ny_credential_stage s JOIN public.licenses l
  ON l.source_system=s.source_system AND l.external_key=s.external_key
GROUP BY source_dataset ORDER BY source_dataset;

COMMIT;
