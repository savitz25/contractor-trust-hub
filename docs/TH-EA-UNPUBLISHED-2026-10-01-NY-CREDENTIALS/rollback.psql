-- REVIEW PACKET ONLY. Separate Founder rollback authorization required.
-- Deletes only the two certified NY DOL credential batches, with matching source hashes.
BEGIN;

DO $$
BEGIN
  IF EXISTS (
    SELECT 1 FROM public.licenses
    WHERE ingest_batch_id IN ('ef3a17a2-75fd-5e1b-af1b-3ac5be7944ac','8875f5a5-a2f1-58fc-86f9-854b0cec6b7f')
      AND (source_system <> 'ny_dol' OR contractor_id IS NOT NULL
        OR raw_payload->>'_grain' <> 'standalone regulator credential'
        OR (ingest_batch_id='ef3a17a2-75fd-5e1b-af1b-3ac5be7944ac'
          AND (raw_payload->>'_source_dataset' <> 'ny_dol_mold'
            OR raw_payload->>'_source_sha256' <> 'bdbf258434d772810a2027a3fd5fa679b8210435ed1126cdc5fb1e34194bfb5c'))
        OR (ingest_batch_id='8875f5a5-a2f1-58fc-86f9-854b0cec6b7f'
          AND (raw_payload->>'_source_dataset' <> 'ny_elevator'
            OR raw_payload->>'_source_sha256' <> '9e5455d1aeec34a399d6e81c5bb55fba4dac42e4399ca01140a893fa5a982244')))
  ) THEN RAISE EXCEPTION 'Rollback scope contains an unexpected or attached license'; END IF;
  IF (SELECT count(*) FROM public.licenses WHERE ingest_batch_id='ef3a17a2-75fd-5e1b-af1b-3ac5be7944ac') > 2510
     OR (SELECT count(*) FROM public.licenses WHERE ingest_batch_id='8875f5a5-a2f1-58fc-86f9-854b0cec6b7f') > 302
  THEN RAISE EXCEPTION 'Rollback batch exceeds certified bounds'; END IF;
END $$;

DELETE FROM public.licenses
WHERE ingest_batch_id IN ('ef3a17a2-75fd-5e1b-af1b-3ac5be7944ac','8875f5a5-a2f1-58fc-86f9-854b0cec6b7f')
  AND source_system='ny_dol' AND contractor_id IS NULL;

DELETE FROM public.ingest_batches
WHERE id IN ('ef3a17a2-75fd-5e1b-af1b-3ac5be7944ac','8875f5a5-a2f1-58fc-86f9-854b0cec6b7f')
  AND source_system='ny_dol' AND source_dataset IN ('ny_dol_mold','ny_elevator')
  AND NOT EXISTS (SELECT 1 FROM public.licenses WHERE ingest_batch_id=ingest_batches.id);

COMMIT;
