-- REVIEW PACKET ONLY. Separate Founder rollback authorization required.
-- Deletes only the two certified NY DOL credential batches, with matching source hashes.
BEGIN;

DO $$
BEGIN
  IF EXISTS (
    SELECT 1 FROM public.licenses
    WHERE ingest_batch_id IN ('637955be-0fc3-5beb-aa6f-52904f3184f0','cf41ef92-452b-553d-927e-f3944c3d2dfd')
      AND (source_system <> 'ny_dol' OR contractor_id IS NOT NULL
        OR raw_payload->>'_grain' IS DISTINCT FROM 'standalone regulator credential'
        OR (ingest_batch_id='637955be-0fc3-5beb-aa6f-52904f3184f0'
          AND (raw_payload->>'_source_dataset' IS DISTINCT FROM 'ny_dol_mold'
            OR raw_payload->>'_source_sha256' IS DISTINCT FROM '5eda889f071350c8e1c1bed040f177de1b0a28e64619afabadb9a4fae468927c'))
        OR (ingest_batch_id='cf41ef92-452b-553d-927e-f3944c3d2dfd'
          AND (raw_payload->>'_source_dataset' IS DISTINCT FROM 'ny_elevator'
            OR raw_payload->>'_source_sha256' IS DISTINCT FROM '4e7dd536aacb197589ffc0df56c35ffc2b6289912cb24bf6289bd141b2f741da')))
  ) THEN RAISE EXCEPTION 'Rollback scope contains an unexpected or attached license'; END IF;
  IF (SELECT count(*) FROM public.licenses WHERE ingest_batch_id='637955be-0fc3-5beb-aa6f-52904f3184f0') > 2511
     OR (SELECT count(*) FROM public.licenses WHERE ingest_batch_id='cf41ef92-452b-553d-927e-f3944c3d2dfd') > 302
  THEN RAISE EXCEPTION 'Rollback batch exceeds certified bounds'; END IF;
  IF EXISTS (
    SELECT 1 FROM public.ingest_batches b
    WHERE b.id IN ('637955be-0fc3-5beb-aa6f-52904f3184f0','cf41ef92-452b-553d-927e-f3944c3d2dfd')
      AND (b.source_system IS DISTINCT FROM 'ny_dol'
        OR (b.id='637955be-0fc3-5beb-aa6f-52904f3184f0'
          AND (b.source_dataset IS DISTINCT FROM 'ny_dol_mold'
            OR b.checksum_sha256 IS DISTINCT FROM '5eda889f071350c8e1c1bed040f177de1b0a28e64619afabadb9a4fae468927c'))
        OR (b.id='cf41ef92-452b-553d-927e-f3944c3d2dfd'
          AND (b.source_dataset IS DISTINCT FROM 'ny_elevator'
            OR b.checksum_sha256 IS DISTINCT FROM '4e7dd536aacb197589ffc0df56c35ffc2b6289912cb24bf6289bd141b2f741da')))
  ) THEN RAISE EXCEPTION 'Rollback ingest batch metadata differs'; END IF;
END $$;

DELETE FROM public.licenses
WHERE ingest_batch_id IN ('637955be-0fc3-5beb-aa6f-52904f3184f0','cf41ef92-452b-553d-927e-f3944c3d2dfd')
  AND source_system='ny_dol' AND contractor_id IS NULL;

DELETE FROM public.ingest_batches
WHERE id IN ('637955be-0fc3-5beb-aa6f-52904f3184f0','cf41ef92-452b-553d-927e-f3944c3d2dfd')
  AND source_system='ny_dol' AND source_dataset IN ('ny_dol_mold','ny_elevator')
  AND NOT EXISTS (SELECT 1 FROM public.licenses WHERE ingest_batch_id=ingest_batches.id);

COMMIT;
