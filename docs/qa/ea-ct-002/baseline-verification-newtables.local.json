  "permit_attributions__constraints": [
    {
      "conname": "permit_attributions_matched_contractor_id_fkey",
      "def": "FOREIGN KEY (matched_contractor_id) REFERENCES contractors(id) ON DELETE SET NULL"
    },
    {
      "conname": "permit_attributions_matched_license_id_fkey",
      "def": "FOREIGN KEY (matched_license_id) REFERENCES licenses(id) ON DELETE SET NULL"
    },
    {
      "conname": "permit_attributions_matched_local_credential_id_fkey",
      "def": "FOREIGN KEY (matched_local_credential_id) REFERENCES local_credentials(id) ON DELETE SET NULL"
    },
    {
      "conname": "permit_attributions_permit_source_record_id_fkey",
      "def": "FOREIGN KEY (permit_source_record_id) REFERENCES permit_source_records(id) ON DELETE CASCADE"
    },
    {
      "conname": "permit_attributions_permit_source_record_id_key",
      "def": "UNIQUE (permit_source_record_id)"
    },
    {
      "conname": "permit_attributions_pkey",
      "def": "PRIMARY KEY (id)"
    },
    {
      "conname": "permit_attributions_state_check",
      "def": "CHECK ((identity_state = ANY (ARRAY['CONFIRMED'::text, 'HIGH_CONFIDENCE'::text, 'REVIEW_REQUIRED'::text, 'UNRESOLVED'::text])))"
    }
  ],
  "permit_source_records__constraints": [
    {
      "conname": "permit_source_records_pkey",
