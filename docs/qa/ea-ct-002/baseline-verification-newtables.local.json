    },
    {
      "conname": "permit_source_records_source_system_source_jurisdiction_per_key",
      "def": "UNIQUE (source_system, source_jurisdiction, permit_number)"
    },
    {
      "conname": "permit_source_records_status_check",
      "def": "CHECK ((status_normalized = ANY (ARRAY['applied'::text, 'under_review'::text, 'ready_for_issuance'::text, 'issued'::text, 'active'::text, 'inactive'::text, 'expired'::text, 'stop_issue'::text, 'cancelled'::text, 'final'::text, 'closed'::text, 'unknown'::text])))"
